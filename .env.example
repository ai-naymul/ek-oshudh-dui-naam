# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# WhatsApp Cloud API (Meta test number)
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
# App secret (Meta app dashboard > Settings > Basic): lets the webhook reject forged requests
WA_APP_SECRET=
# Graph API version for WhatsApp calls
WA_API_VERSION=v23.0
# Public base URL of the backend (Cloudflare quick tunnel). Optional: if empty, the webhook uses the URL it was called on
PUBLIC_API_URL=
